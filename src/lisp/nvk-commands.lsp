      (if (vl-catch-all-error-p r)
        (princ (strcat "\n[НВК] " (vl-catch-all-error-message r)))
        (princ (strcat "\n" (if r (vl-princ-to-string r) "готово"))))))
  (princ))

(defun C:НВК-ДВИГАТЬ ( / r)
  (if (not (nvk-dll-zagruzit))
    (princ "\n[НВК] без DLL.")
    (progn
      (nvk-layout-send)
      (setq r (vl-catch-all-apply 'nvk-move nil))
      (cond
        ((vl-catch-all-error-p r)
         (princ (strcat "\n[НВК] " (vl-catch-all-error-message r))))
        (t
         (nvk-layout-pull)
         (vl-catch-all-apply 'nvk-nod-sohranit nil)
         (princ "\n[НВК] точка записана в NOD. Обновить — перестроит на месте.")))))
  (princ))

