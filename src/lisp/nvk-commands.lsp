(defun C:НВК-ИНФО ( / dll-s)
  (nvk-dll-zagruzit)
  (setq dll-s (vl-catch-all-apply 'nvk-dll-ping-stroka nil))
  (if (vl-catch-all-error-p dll-s) (setq dll-s (vl-catch-all-error-message dll-s)))
  (princ "\n")
  (princ "╔══════════════════════════════════════════════╗")
  (princ (strcat "\n║  Поперечник НВК  " *nvk-versija*))
  (princ "\n╠══════════════════════════════════════════════╣")
  (princ (strcat "\n║  папка  " *nvk-dir*))
  (princ (strcat "\n║  DLL    " (if *nvk-dll-ok* "да" "нет")
                 "  " (if dll-s dll-s "?")))
  (princ (strcat "\n║  блоки  CS=" (if *nvk-block-cs* "да" "нет")
                 "  EP=" (if *nvk-block-ep* "да" "нет")
                 "  POPER=" (if *nvk-block-poper* "да" "нет")
                 "  TIN±" (rtos *nvk-cs-hwidth* 2 1) "м"))
  (princ (strcat "\n║  труб   " (if (and *nvk-pipe-ss* (> (sslength *nvk-pipe-ss*) 0))
                      (itoa (sslength *nvk-pipe-ss*)) "нет")
                 "  TIN=" (if *nvk-surf-name* *nvk-surf-name* "-")))
  (princ (strcat "\n║  CS pt  " (nvk-pt-str *nvk-cs-ins*)
                 "  EP pt " (nvk-pt-str *nvk-ep-ins*)))
  (princ "\n╠══════════════════════════════════════════════╣")
  (princ "\n║  два исходника: труба + TIN                  ║")
  (princ "\n║  TrenchBottom → низ разработки и низ песка   ║")
  (princ "\n║  SandTop      → низ защиты (верх песка)      ║")
  (princ "\n║  ZashTop      → низ засыпки                  ║")
  (princ "\n╠══════════════════════════════════════════════╣")
  (princ "\n║  НВК-ПОСТРОИТЬ  все этапы, лог OK/SKIP/FAIL  ║")
  (princ "\n║  НВК-ВВОД       трубы + TIN                  ║")
  (princ (strcat "\n║  лог    " *nvk-dir* "\\nvk-log.txt"))
  (princ "\n║  НВК-ДАМП       домен в nvk-log.txt          ║")
  (princ "\n║  НВК-СЕЧЕНИЯ    поперечники (блок/россыпь)   ║")
