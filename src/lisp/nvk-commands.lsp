;; AutoLISP: не больше 128 аргументов. NVK-UI-PUT пачками, иначе otdat молча падает
;; и панель/домен остаются без ZONES после открытия чертежа.
(defun nvk-ui-put-pairs (lst / chunk n)
  (if (not (car (atoms-family 1 '("NVK-UI-PUT"))))
    nil
    (progn
      (while lst
        (setq chunk nil n 0)
        (while (and lst (< n 80))
          (setq chunk (append chunk (list (car lst)))
                lst (cdr lst)
                n (1+ n)))
        (if chunk (vl-catch-all-apply 'nvk-ui-put chunk)))
      T)))

