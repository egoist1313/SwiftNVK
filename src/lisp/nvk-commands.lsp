(defun nvk-pt-str (p)
  (if (and p (listp p) (>= (length p) 2))
    (strcat (rtos (car p) 2 1) "," (rtos (cadr p) 2 1))
    "-"))

(defun C:НВК-НАСТРОЙКИ ( / )
  (nvk-dialog-nastrojki)
  (princ))

(defun nvk-plist-get (lst key)
  (cond
    ((null lst) nil)
    ((equal (strcase (car lst)) (strcase key)) (cadr lst))
    (t (nvk-plist-get (cddr lst) key))))

(defun nvk-ui-01 (s) (and s (/= s "0") (/= s "")))

