(defun nvk-ui-primenit ( / a v)
  (setq a (vl-catch-all-apply 'nvk-ui-get nil))
  (if (or (null a) (vl-catch-all-error-p a) (not (listp a)))
    nil
    (progn
      (if (setq v (nvk-plist-get a "BEDDING"))  (setq *nvk-bedding*   (atof v)))
      (if (setq v (nvk-plist-get a "THK_ZASH")) (setq *nvk-thk-zash*  (atof v)))
      (if (setq v (nvk-plist-get a "THK_ASPH")) (setq *nvk-thk-asph*  (atof v)))
      (if (setq v (nvk-plist-get a "THK_GAZN")) (setq *nvk-thk-gazn*  (atof v)))
      (if (setq v (nvk-plist-get a "THK_TROT")) (setq *nvk-thk-trot*  (atof v)))
      (if (setq v (nvk-plist-get a "THK_OTHER")) (setq *nvk-thk-other* (atof v)))
      (if (setq v (nvk-plist-get a "FILL_ASPH")) (setq *nvk-fill-asph* v))
      (if (setq v (nvk-plist-get a "FILL_TROT")) (setq *nvk-fill-trot* v))
      (if (setq v (nvk-plist-get a "FILL_GAZN")) (setq *nvk-fill-gazn* v))
      (if (setq v (nvk-plist-get a "FILL_OTHER")) (setq *nvk-fill-other* v))
      (if (setq v (nvk-plist-get a "USE_BE")) (setq *nvk-use-black-earth* (nvk-ui-01 v)))
      (if (setq v (nvk-plist-get a "BE_H")) (setq *nvk-black-earth-h* v))
      (if (setq v (nvk-plist-get a "BE_N")) (setq *nvk-black-earth-n* v))
      (if (setq v (nvk-plist-get a "DESIGN_H"))
        (if (and v (> (strlen v) 0))
          (setq *nvk-surf-handle* v)))
      (if (setq v (nvk-plist-get a "DESIGN_N"))
        (if (and v (> (strlen v) 0))
          (setq *nvk-surf-name* v)))
      (if (setq v (nvk-plist-get a "L1_MH")) (setq *nvk-l1-mh* (nvk-ui-01 v)))
      (if (setq v (nvk-plist-get a "TBL_OFF")) (setq *nvk-table-off-m* (atof v)))
      (if (setq v (nvk-plist-get a "L1_PRESET")) (setq *nvk-l1-preset* v))
      (if (setq v (nvk-plist-get a "CS_YGAP"))  (setq *nvk-cs-ygap*   (atof v)))
      (if (setq v (nvk-plist-get a "JOINT"))
        (if (> (strlen v) 0) (setq *nvk-joint* v)))
      (if (setq v (nvk-plist-get a "SLOPE"))    (setq *nvk-cs-slope*  (atof v)))
      (if (setq v (nvk-plist-get a "HWIDTH"))   (setq *nvk-cs-hwidth* (atof v)))
      (if (setq v (nvk-plist-get a "H_SCALE"))  (setq *nvk-h-scale*   (atof v)))
      (if (setq v (nvk-plist-get a "L_SCALE"))  (setq *nvk-l-scale*   (atof v)))
      (if (setq v (nvk-plist-get a "CS_SCALE")) (setq *nvk-cs-scale*  (atof v)))
      (if (setq v (nvk-plist-get a "CS_TH"))    (setq *nvk-cs-text-h* (atof v)))
      (if (setq v (nvk-plist-get a "TEXT_H"))   (setq *nvk-text-h*    (atof v)))
      (if (setq v (nvk-plist-get a "TEXT_OFF")) (setq *nvk-text-off*  (atof v)))
