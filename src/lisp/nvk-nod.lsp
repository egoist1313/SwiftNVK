        (setq *nvk-vol-ins* (list (atof v) (atof (nvk-nod-get a "VOL_Y")))))
      (setq hs (nvk-nod-get a "PIPES")  ss nil)
      (if (and hs (> (strlen hs) 0))
        (foreach h (nvk-split hs ";")
          (setq en (handent h))
          (if en
            (setq ss (if ss (progn (ssadd en ss) ss) (ssadd en))))))
      (if ss (setq *nvk-pipe-ss* ss))
      (if (setq v (nvk-nod-get a "EP_LVLS"))
        (setq *nvk-ep-lpts* (nvk-lpts-parse v)))
      (if (setq v (nvk-nod-get a "CS_LVLS"))
