                       (itoa (sslength *nvk-pipe-ss*)) "0")
                     "  TIN=" (if *nvk-surf-name* *nvk-surf-name* "-")
                     "  покрытия="
                     (if (and *nvk-zones-str* (> (strlen *nvk-zones-str*) 0))
                       *nvk-zones-str* "(нет)")))
      T))
  (vl-catch-all-apply 'nvk-nod-import-pb (list had))
  (if (or had *nvk-pipe-ss* *nvk-cs-ins* *nvk-ep-ins*) T nil))

(if (not (boundp '*nvk-doc-key*)) (setq *nvk-doc-key* nil))

(defun nvk-doc-key ( )
  (strcat (if (getvar "DWGPREFIX") (getvar "DWGPREFIX") "")
          (if (getvar "DWGNAME") (getvar "DWGNAME") "")))

;; BecameCurrent срабатывает и на Обновить/команды — не трогаем зоны того же DWG.
(defun nvk-on-doc (rea cmd / k)
  (setq k (nvk-doc-key))
  (if (and k (> (strlen k) 0) (not (equal k *nvk-doc-key*)))
    (progn
      (setq *nvk-doc-key* k)
      (vl-catch-all-apply 'nvk-nod-zagruzit nil)
      (if (and (boundp 'nvk-ui-otdat) (car (atoms-family 1 '("NVK-UI-PUT"))))
        (vl-catch-all-apply 'nvk-ui-otdat nil)))))

(defun nvk-doc-reactor ( / )
  (if (and (boundp '*nvk-doc-reac*) *nvk-doc-reac*)
    (vl-catch-all-apply 'vlr-remove (list *nvk-doc-reac*)))
  (setq *nvk-doc-reac*
        (vlr-docmanager-reactor
          nil
          (list
            (cons :vlr-documentBecameCurrent 'nvk-on-doc)
            (cons :vlr-documentCreated 'nvk-on-doc)))))

(vl-catch-all-apply 'nvk-doc-reactor nil)

