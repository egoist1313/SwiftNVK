      (if (setq v (nvk-nod-get-any a '("H_SCALE" "HSCALE")))  (setq *nvk-h-scale*   (atof v)))
      (if (setq v (nvk-nod-get-any a '("L_SCALE" "LSCALE")))  (setq *nvk-l-scale*   (atof v)))
      (if (setq v (nvk-nod-get a "STATIONS"))
        (if (> (strlen v) 0) (setq *nvk-stations-str* v)))
      (if (setq v (nvk-nod-get a "BLOCK_CS"))
        (if (> (strlen v) 0) (setq *nvk-block-cs* (/= v "0"))))
      (if (setq v (nvk-nod-get a "BLOCK_EP"))
        (if (> (strlen v) 0) (setq *nvk-block-ep* (/= v "0"))))
      (if (setq v (nvk-nod-get a "SHOW_TAGS"))
        (if (> (strlen v) 0) (setq *nvk-show-tags* (/= v "0"))))
      (if (and (setq v (nvk-nod-get a "HWIDTH")) (> (strlen v) 0))
        (setq *nvk-cs-hwidth* (atof v)))
      (if (and (setq v (nvk-nod-get-any a '("TEXT_H" "TEXT_HEIGHT"))) (> (strlen v) 0))
        (setq *nvk-text-h* (atof v)))
      (if (and (setq v (nvk-nod-get-any a '("CS_TH" "CS_TEXT_H" "CS_TEXT"))) (> (strlen v) 0))
        (setq *nvk-cs-text-h* (atof v)))
      (if (and (setq v (nvk-nod-get a "TEXT_OFF")) (> (strlen v) 0))
        (setq *nvk-text-off* (atof v)))
      (if (and (setq v (nvk-nod-get a "ROUND_TO")) (> (strlen v) 0))
        (setq *nvk-round-to* (atoi v)))
      (if (and (setq v (nvk-nod-get a "SLOPE_RND")) (> (strlen v) 0))
        (setq *nvk-slope-round* (atoi v)))
      (if (and (setq v (nvk-nod-get a "SLOPE_U")) (> (strlen v) 0))
        (setq *nvk-slope-unit* v))
      (if (setq v (nvk-nod-get a "SHOW_PERM"))
        (if (> (strlen v) 0) (setq *nvk-show-permille* (/= v "0"))))
      (if (setq v (nvk-nod-get a "SHOW_LEN"))
        (if (> (strlen v) 0) (setq *nvk-show-len* (/= v "0"))))
      (if (setq v (nvk-nod-get a "SHOW_SLP"))
        (if (> (strlen v) 0) (setq *nvk-show-slope* (/= v "0"))))
