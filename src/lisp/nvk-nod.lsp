        (setq *nvk-label-col-w* (atof v)))
      (setq *nvk-surf-handle* (nvk-nod-get a "SURF_H")
            *nvk-surf-name*   (nvk-nod-get a "SURF_N"))
      (if (and *nvk-surf-handle* (= *nvk-surf-handle* "")) (setq *nvk-surf-handle* nil))
      (if (and *nvk-surf-name* (= *nvk-surf-name* "")) (setq *nvk-surf-name* nil))
      (setq v (nvk-nod-get a "CS_X"))
      (if (and v (> (strlen v) 0) (nvk-nod-get a "CS_Y") (> (strlen (nvk-nod-get a "CS_Y")) 0))
        (setq *nvk-cs-ins* (list (atof v) (atof (nvk-nod-get a "CS_Y")))))
      (setq v (nvk-nod-get a "EP_X"))
      (if (and v (> (strlen v) 0) (nvk-nod-get a "EP_Y") (> (strlen (nvk-nod-get a "EP_Y")) 0))
        (setq *nvk-ep-ins* (list (atof v) (atof (nvk-nod-get a "EP_Y")))))
      (setq v (nvk-nod-get a "VOL_X"))
