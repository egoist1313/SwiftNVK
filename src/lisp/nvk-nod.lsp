      (if (and (setq v (nvk-nod-get a "PLAN_INT")) (> (strlen v) 0)) (setq *nvk-plan-int* (atof v)))
      (if (and (setq v (nvk-nod-get a "PLAN_MIN")) (> (strlen v) 0)) (setq *nvk-plan-min* (atof v)))
      (if (setq v (nvk-nod-get a "DRAW_PROJ"))
        (if (> (strlen v) 0) (setq *nvk-draw-proj* (/= v "0"))))
