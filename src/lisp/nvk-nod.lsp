(defun nvk-nod-zagruzit ( / a v hs ss en had)
  (setq a (nvk-nod-chitat)  had a)
  (if a
    (progn
      (if (setq v (nvk-nod-get-any a '("BEDDING")))  (setq *nvk-bedding*   (atof v)))
      (if (setq v (nvk-nod-get-any a '("THK_ZASH" "THK_ZASHITA" "ZASHITA")))
