<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.277.0</Version>
    <AssemblyName>Nvk.Cad</AssemblyName>
    <RootNamespace>Nvk.Cad</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AcadDir>E:\Programs\ACAD2025\AutoCAD 2025</AcadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Core sources compiled into Nvk.Cad.dll. Nvk.Core.csproj stays for tests only. -->
  <ItemGroup>
    <Compile Include="..\Nvk.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyToNvkBin" AfterTargets="Build">
    <PropertyGroup>
      <NvkBin>$(MSBuildProjectDirectory)\..\..\..\bin</NvkBin>
    </PropertyGroup>
    <MakeDir Directories="$(NvkBin)" />
    <MakeDir Directories="$(NvkBin)\v277" />
    <MakeDir Directories="$(NvkBin)\v276" />
    <MakeDir Directories="$(NvkBin)\v275" />
    <MakeDir Directories="$(NvkBin)\v274" />
    <MakeDir Directories="$(NvkBin)\v273" />
    <MakeDir Directories="$(NvkBin)\v272" />
    <MakeDir Directories="$(NvkBin)\v271" />
    <MakeDir Directories="$(NvkBin)\v270" />
    <MakeDir Directories="$(NvkBin)\v269" />
    <MakeDir Directories="$(NvkBin)\v268" />
    <MakeDir Directories="$(NvkBin)\v267" />
    <MakeDir Directories="$(NvkBin)\v266" />
    <MakeDir Directories="$(NvkBin)\v265" />
    <MakeDir Directories="$(NvkBin)\v264" />
    <MakeDir Directories="$(NvkBin)\v263" />
    <MakeDir Directories="$(NvkBin)\v262" />
    <MakeDir Directories="$(NvkBin)\v261" />
    <MakeDir Directories="$(NvkBin)\v260" />
    <MakeDir Directories="$(NvkBin)\v259" />
    <MakeDir Directories="$(NvkBin)\v258" />
    <MakeDir Directories="$(NvkBin)\v257" />
    <MakeDir Directories="$(NvkBin)\v256" />
    <MakeDir Directories="$(NvkBin)\v255" />
    <MakeDir Directories="$(NvkBin)\v254" />
    <MakeDir Directories="$(NvkBin)\v253" />
    <MakeDir Directories="$(NvkBin)\v252" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\out_build" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v277" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v276" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v275" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v274" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v273" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v272" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v271" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v270" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v269" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v268" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v267" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v266" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v265" SkipUnchangedFiles="false" ContinueOnError="true" />
