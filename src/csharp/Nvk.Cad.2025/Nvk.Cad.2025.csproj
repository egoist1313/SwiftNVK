<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.196.0</Version>
    <AssemblyName>Nvk.Cad</AssemblyName>
    <RootNamespace>Nvk.Cad</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AcadDir>E:\Programs\ACAD2025\AutoCAD 2025</AcadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AecBaseMgd">
      <HintPath>$(AcadDir)\ACA\AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(AcadDir)\C3D\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Core sources compiled into Nvk.Cad.dll. Nvk.Core.csproj stays for tests only. -->
  <ItemGroup>
    <Compile Include="..\Nvk.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyToNvkBin" AfterTargets="Build">
    <PropertyGroup>
      <NvkBin>$(MSBuildProjectDirectory)\..\..\..\bin</NvkBin>
    </PropertyGroup>
    <MakeDir Directories="$(NvkBin)" />
    <MakeDir Directories="$(NvkBin)\v196" />
    <MakeDir Directories="$(NvkBin)\v195" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\out_build" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v196" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(NvkBin)\v195" SkipUnchangedFiles="false" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\out_build" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>
</Project>
